# Application
APP_NAME=Local LLM
APP_VERSION=0.1.0
DEBUG=true

# LLM
# Choose one provider/model pair and comment out the others.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.6-luna
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_PROVIDER=kimi
# LLM_MODEL=kimi-k2.6
LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL=groq/compound

# OpenAI
OPENAI_API_KEY=openai_api_key

# Gemini
GEMINI_API_KEY=gemini_api_key

# Groq
GROQ_API_KEY=groq_api_key

# Kimi (OpenAI-compatible endpoint)
KIMI_API_KEY=kimi_api_key
# KIMI_BASE_URL=https://litellm.ai.netcracker.cloud/v1
KIMI_BASE_URL=http://localhost:9000/v1

# Ollama (optional, local provider)
OLLAMA_BASE_URL=http://localhost:11434

# CORS
# Comma-separated list of allowed origins. Use "*" for local development.
CORS_ORIGINS=*

# Database
# Optional: override the default SQLite database path.
# DATABASE_URL=sqlite+aiosqlite:///data/local_llm.db